{
  "name": "crab",
  "image": "koalby/urchin-framework",
  "essential": false,
  "autostart": false,
  "depends": [
    "cortex-bridge"
  ],
  "env": {
    "ROS_DOMAIN_ID": "42",
    "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp"
  },
  "health_check": {
    "enabled": true,
    "restart_on_failure": true,
    "max_restarts": 3
  },
  "privileged": true,
  "devices": [],
  "volumes": [
    "/dev:/dev",
    "/sys:/sys:ro",
    "/run/udev:/run/udev:ro"
  ]
}
